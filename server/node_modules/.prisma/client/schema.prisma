datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile    Profile?
  workouts   Workout[]
  sessions   WorkoutSession[]
  dietNotes  DietNote[]
  waterLogs  WaterIntake[]
  weightLogs WeightRecord[]
  habits     Habit[]
  sleepLogs  SleepRecord[]
  goals      Goal[]
  photos     ProgressPhoto[]
  journals   Journal[]
  settings   NotificationSettings?
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String   @default("Fitness Enthusiast")
  age              Int      @default(25)
  gender           String   @default("Other")
  height           Float    @default(170) // in cm
  weight           Float    @default(70) // in kg
  fitnessGoal      String   @default("Maintain Weight") // Lose Weight, Gain Muscle, Maintenance, Endurace
  targetWeight     Float    @default(68) // in kg
  dailyCalorieGoal Int      @default(2200)
  avatarUrl        String?
  unitSystem       String   @default("metric") // metric (kg/cm) or imperial (lbs/in)
  theme            String   @default("dark")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Workout {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String     @default("Custom") // Chest, Back, Legs, Arms, Shoulder, Cardio, Core, Yoga, Stretching, Custom
  description String?
  exercises   Exercise[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Exercise {
  id          String  @id @default(uuid())
  workoutId   String
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name        String
  muscleGroup String  @default("Full Body")
  sets        Int     @default(3)
  reps        Int     @default(10)
  weight      Float   @default(0) // kg
  duration    Int     @default(0) // seconds or minutes
  restTime    Int     @default(60) // seconds
  notes       String?
  metValue    Float   @default(5.0)
}

model WorkoutSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutName     String
  category        String   @default("Custom")
  durationSeconds Int      @default(0)
  caloriesBurned  Float    @default(0)
  date            String // YYYY-MM-DD
  notes           String?
  createdAt       DateTime @default(now())
}

model DietNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType  String // Breakfast, Lunch, Dinner, Snacks, Pre Workout, Post Workout, Supplements
  foodName  String
  quantity  String   @default("1 serving")
  calories  Float    @default(0)
  protein   Float    @default(0) // grams
  carbs     Float    @default(0) // grams
  fat       Float    @default(0) // grams
  notes     String?
  date      String // YYYY-MM-DD
  createdAt DateTime @default(now())
}

model WaterIntake {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  glasses       Int      @default(0) // 250ml per glass
  targetGlasses Int      @default(12)
  date          String // YYYY-MM-DD
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
}

model WeightRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  date      String // YYYY-MM-DD
  notes     String?
  createdAt DateTime @default(now())
}

model Habit {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  completed         Boolean  @default(false)
  streak            Int      @default(0)
  lastCompletedDate String? // YYYY-MM-DD
  createdAt         DateTime @default(now())
}

model SleepRecord {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepTime     String // e.g. "23:00"
  wakeTime      String // e.g. "07:00"
  durationHours Float    @default(8.0)
  qualityScore  Int      @default(8) // 1 to 10
  date          String // YYYY-MM-DD
  notes         String?
  createdAt     DateTime @default(now())
}

model Goal {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  category     String   @default("Fitness") // Fitness, Weight, Water, Steps, Habit
  targetValue  Float
  currentValue Float    @default(0)
  unit         String   @default("kg")
  deadline     String? // YYYY-MM-DD
  status       String   @default("in_progress") // in_progress, completed, abandoned
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProgressPhoto {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewType  String // Front, Side, Back
  imageUrl  String
  date      String // YYYY-MM-DD
  notes     String?
  createdAt DateTime @default(now())
}

model Journal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      String   @default("😊 Energetic")
  content   String
  date      String // YYYY-MM-DD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationSettings {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutTime   String   @default("08:00")
  waterInterval Int      @default(60) // minutes
  mealTime      String   @default("13:00")
  sleepTime     String   @default("22:30")
  weightCheck   String   @default("07:00")
  enabled       Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}
