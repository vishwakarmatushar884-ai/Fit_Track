datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  password     String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  profile      Profile?
  workouts     Workout[]
  sessions     WorkoutSession[]
  dietNotes    DietNote[]
  waterLogs    WaterIntake[]
  weightLogs   WeightRecord[]
  habits       Habit[]
  sleepLogs    SleepRecord[]
  goals        Goal[]
  photos       ProgressPhoto[]
  journals     Journal[]
  todos        Todo[]
  settings     NotificationSettings?
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String   @default("Fitness Enthusiast")
  age              Int      @default(25)
  gender           String   @default("Other")
  height           Float    @default(170) // in cm
  weight           Float    @default(70)  // in kg
  fitnessGoal      String   @default("Maintain Weight")
  targetWeight     Float    @default(70)
  dailyCalorieGoal Int      @default(2000)
  avatarUrl        String?
  unitSystem       String   @default("metric") // metric, imperial
  theme            String   @default("dark")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Workout {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String   @default("Strength")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercises   Exercise[]
  sessions    WorkoutSession[]
}

model Exercise {
  id          String   @id @default(uuid())
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name        String
  sets        Int      @default(3)
  reps        Int      @default(10)
  weight      Float    @default(0) // in kg
  restSeconds Int      @default(60)
  notes       String?
}

model WorkoutSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId      String?
  workout        Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  duration       Int      // in minutes
  caloriesBurned Int
  notes          String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
}

model DietNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType  String   // Breakfast, Lunch, Dinner, Snack
  foodName  String
  calories  Int
  protein   Float?   @default(0) // in grams
  carbs     Float?   @default(0)
  fat       Float?   @default(0)
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaterIntake {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int      // in ml
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())
}

model WeightRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float    // in kg
  date      String   // YYYY-MM-DD
  notes     String?
  createdAt DateTime @default(now())
}

model Habit {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String   @default("General")
  frequency   String   @default("Daily") // Daily, Weekly
  completed   Boolean  @default(false)
  streak      Int      @default(0)
  lastLogged  String?  // YYYY-MM-DD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SleepRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duration  Float    // in hours
  quality   String   @default("Good") // Excellent, Good, Fair, Poor
  date      String   // YYYY-MM-DD
  notes     String?
  createdAt DateTime @default(now())
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  targetValue Float
  currentValue Float   @default(0)
  unit        String   @default("kg")
  targetDate  String   // YYYY-MM-DD
  category    String   @default("Fitness") // Fitness, Weight, Habit
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProgressPhoto {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl  String
  tag       String   @default("Front") // Front, Side, Back
  date      String   // YYYY-MM-DD
  notes     String?
  createdAt DateTime @default(now())
}

model Journal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      String   @default("😊 Energetic")
  content   String
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Todo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  String   @default("General") // Workout, Nutrition, Hydration, Mental, General
  priority  String   @default("Medium")  // High, Medium, Low
  dueDate   String?  // YYYY-MM-DD
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationSettings {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutTime   String   @default("08:00")
  waterInterval Int      @default(60)
  mealTime      String   @default("13:00")
  sleepTime     String   @default("22:30")
  weightCheck   String   @default("07:00")
  enabled       Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}
